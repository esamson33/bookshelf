# Secrets — holds the OpenAI API key. See .bookshelf.toml.example.
.bookshelf.toml

# User data: the catalog of this machine's shelf (titles, summaries, history),
# plus its backups and SQLite journal files. Created on first run.
.bookshelf.db*

# The shelf itself: ~2.5G of PDFs, tracked in the catalog DB, not in git.
data/

